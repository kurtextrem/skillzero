{
	"name": "skillzero",
	"version": "0.2.0",
	"description": "CLI for hiding agent skills and creating focused collections.",
	"keywords": [
		"agent-skills",
		"ai-agents",
		"claude-code",
		"cli",
		"codex",
		"cursor"
	],
	"homepage": "https://github.com/kurtextrem/skillzero#readme",
	"bugs": {
		"url": "https://github.com/kurtextrem/skillzero/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kurtextrem/skillzero.git"
	},
	"license": "MIT",
	"bin": {
		"skillzero": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "bun src/index.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:package": "node scripts/smoke-package.mjs",
		"release": "npm publish --ignore-scripts=false",
		"prepublishOnly": "aube run typecheck && aube test && aube run test:package",
		"prepack": "aube run build",
		"format": "oxfmt"
	},
	"packageManager": "aube@1.37.0",
	"devDependencies": {
		"@11ty/gray-matter": "^3.0.0",
		"@clack/core": "^1.4.3",
		"@clack/prompts": "^1.7.0",
		"@types/node": "^22.0.0",
		"cac": "^7.0.0",
		"oxfmt": "^0.62.0",
		"tokenx": "^2.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
